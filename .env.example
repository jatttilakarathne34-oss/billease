# Vercel fills these in for you when you connect storage (Project -> Storage tab).
# For local development run:  vercel env pull .env.local
DATABASE_URL=                 # REQUIRED  - Neon Postgres connection string
BLOB_READ_WRITE_TOKEN=        # OPTIONAL  - Vercel Blob (create the store as PUBLIC). Empty = photos/logo stored in Postgres

# You add these yourself (optional)
JWT_SECRET=                   # any long random text; if empty one is generated and stored in the database
PG_POOL_MAX=4
